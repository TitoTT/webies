# Datos reales del sitio: noticias, consultas con nombres y mails, usuarios del admin
db.sqlite3
db.sqlite3-journal
db.sqlite3-wal
db.sqlite3-shm
*.sqlite3

# Imágenes y PDF subidos desde el admin
media/

# Respaldos (contienen todo lo anterior)
backups/
*.zip

# Claves y configuración privada
.env
.env.*
*.pem
*.key

# Entorno virtual (se reconstruye con: pip install -r requirements.txt)
venv/
.venv/
env/

# Archivos que se generan solos
staticfiles/
__pycache__/
*.py[cod]
*.log

# Archivos de cada editor / sistema
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini